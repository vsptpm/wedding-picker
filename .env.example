# Shown on the login screen and gallery header, e.g. "Anshad & Subhana"
SITE_TITLE="Our Wedding"
# Optional line above the title, e.g. "12 October 2026 · Kochi" (leave empty to hide)
SITE_SUBTITLE=""
# Folder containing one sub-folder per album (BRIDE, GROOM, ...)
PHOTOS_DIR=/Users/vishnus/Downloads/Wedding_Selection_Previews
# Where the SQLite DB and thumbnail cache live
DATA_DIR=./data
# Code guests/family type to sign in
ACCESS_CODE=wedding2026
# Code that signs in with admin rights (export, progress, rescan)
ADMIN_CODE=admin-change-me
# Set to 1 when served over HTTPS
COOKIE_SECURE=0
