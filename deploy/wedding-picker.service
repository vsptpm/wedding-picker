[Unit]
Description=Wedding Photo Picker (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/wedding-picker
EnvironmentFile=/opt/wedding-picker/.env.local
Environment=NODE_ENV=production PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
